# QR Lab Hub - Configuración de entorno de ejemplo

# Base de datos
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/qrlabhub_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/qrlabhub_test

# Aplicación
APP_ENV=development
APP_BASE_URL=http://localhost:8070
APP_TIMEZONE=America/Santiago
SECRET_KEY=cambiar-por-secreto-seguro-en-produccion-32-caracteres-minimo

# Sesión administrativa / API Key
ADMIN_API_KEY=labhub-dev-admin-key-2026

# Correo (SMTP)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_FROM=no-reply@qrlabhub.local
REPORT_TO=coordinador@qrlabhub.local
EMAIL_ENABLED=false
LOCAL_SMTP_ENABLED=true
# Acceso sin clave solamente desde loopback, con APP_ENV=development.
LOCAL_DESKTOP_ACCESS=true

# Almacenamiento de informes
REPORT_OUTPUT_DIR=storage/reports
REPORT_INITIAL_MONTH=2026-01

